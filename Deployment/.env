# ==== Koneksi service ====
HANDLANDMARKER_URL=http://localhost:8001
MODEL_URL=https://despro-bidisgn-model-1031455690132.asia-southeast2.run.app

# ==== Sumber landmark tangan ====
# local paling responsif karena tidak ada round-trip HTTP per frame.
LANDMARK_BACKEND=auto
# HAND_LANDMARKER_MODEL_PATH=../handlandmarker/hand_landmarker.task
HAND_DETECTION_CONFIDENCE=0.20
HAND_PRESENCE_CONFIDENCE=0.20
HAND_TRACKING_CONFIDENCE=0.20

# ==== Window & timing ====
# Seimbang: cukup data untuk mengenali bentuk, tetap responsif.
SEQ_LEN=90
WINDOW_FRAMES=36
MIN_WINDOW_FRAMES=20
STRIDE_FRAMES=2

# ==== Prediksi & stabilisasi (smooth dan konsisten) ====
PREDICTION_THRESHOLD=0.86
TOP1_MARGIN=0.15
# Bobot moderat pada hasil terbaru supaya tidak terlalu bergetar.
PROB_SMOOTH_ALPHA=0.50
VOTE_WINDOW=3
STABLE_PREDICTIONS=2
MIN_VOTE_SHARE=0.67
COMMIT_COOLDOWN_SECONDS=0.25
MIN_HOLD_SECONDS=0.16
RELEASE_AFTER_EMPTY_FRAMES=5
MIN_ACTIVE_RATIO=0.60

# ==== Kunci per gestur (satu gerakan = satu output) ====
LOCK_AFTER_COMMIT=1
REPEAT_COOLDOWN_SECONDS=0.45

# ==== Deteksi gerakan ====
REQUIRE_GESTURE=1
REQUIRE_STABLE_MOTION=1
GESTURE_MOTION_THRESHOLD=0.018
STABLE_MOTION_THRESHOLD=0.035
STABILITY_FRAMES=4
GESTURE_TIMEOUT_SECONDS=4.5
# Slot kiri/kanan tetap mengikuti frame sebelumnya agar dua tangan tidak tertukar.
HAND_SLOT_TRACKING=1

# Tampilkan baris status di video (0 = sembunyikan, tidak mengganggu)
SHOW_STATUS=0

# ==== Kamera ====
CAMERA_INDEX=0
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480
CAPTURE_FPS=30
JPEG_QUALITY=82

# ==== Lain-lain ====
TEXT_LIMIT=160
DEBUG=0
