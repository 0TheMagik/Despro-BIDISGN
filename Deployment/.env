# ==== Koneksi service ====
HANDLANDMARKER_URL=http://localhost:8001
MODEL_URL=http://localhost:8002

# ==== Sumber landmark tangan ====
# auto   = pakai MediaPipe lokal kalau tersedia (paling cepat), kalau tidak pakai service Docker
# local  = MediaPipe langsung di proses client (butuh pip install mediapipe)
# docker = kirim frame ke service handlandmarker
LANDMARK_BACKEND=auto
# HAND_LANDMARKER_MODEL_PATH=../handlandmarker/hand_landmarker.task
# HAND_DETECTION_CONFIDENCE=0.2
# HAND_PRESENCE_CONFIDENCE=0.2
# HAND_TRACKING_CONFIDENCE=0.2

# ==== Window & timing ====
SEQ_LEN=90
WINDOW_FRAMES=36
MIN_WINDOW_FRAMES=24
STRIDE_FRAMES=2

# ==== Prediksi & stabilisasi (anti-noise) ====
# Teks hanya keluar kalau tangan stabil + confidence tinggi + konsensus.
PREDICTION_THRESHOLD=0.90
TOP1_MARGIN=0.20
# Probabilitas tiap prediksi dirata-rata (EMA). Makin kecil = makin halus/tahan noise.
PROB_SMOOTH_ALPHA=0.45
# Butuh N prediksi terakhir sepakat minimal MIN_VOTE_SHARE.
VOTE_WINDOW=4
STABLE_PREDICTIONS=3
MIN_VOTE_SHARE=0.8
COMMIT_COOLDOWN_SECONDS=0.4
MIN_HOLD_SECONDS=0.25
RELEASE_AFTER_EMPTY_FRAMES=6
MIN_ACTIVE_RATIO=0.6

# ==== Kunci per gestur (satu gerakan = satu output) ====
# Setelah teks dikomit, decoder terkunci sampai tangan digerakkan lagi atau dilepas.
LOCK_AFTER_COMMIT=1
# Jeda minimum sebelum boleh commit lagi (mencegah huruf dobel).
REPEAT_COOLDOWN_SECONDS=0.8

# ==== Deteksi gerakan ====
REQUIRE_GESTURE=1
REQUIRE_STABLE_MOTION=1
# Gerakan tangan untuk memulai gestur (koordinat gambar 0..1).
GESTURE_MOTION_THRESHOLD=0.02
# Perubahan bentuk tangan agar dianggap diam (fitur ternormalisasi: tidak terpengaruh jarak kamera).
STABLE_MOTION_THRESHOLD=0.035
STABILITY_FRAMES=4
GESTURE_TIMEOUT_SECONDS=5.0
# Slot tangan kiri/kanan ditempelkan ke frame sebelumnya supaya tidak tertukar.
HAND_SLOT_TRACKING=1

# Tampilkan baris status di video (0 = sembunyikan, tidak mengganggu)
SHOW_STATUS=0

# ==== Kamera ====
CAMERA_INDEX=0
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480
CAPTURE_FPS=30
JPEG_QUALITY=80

# ==== Lain-lain ====
TEXT_LIMIT=160
DEBUG=0
